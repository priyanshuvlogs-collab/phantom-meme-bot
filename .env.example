# ============================================================================
# Phantom Meme Bot — configuration
#
# Copy this file to `.env` and adjust. The bot runs in PAPER MODE by default:
# no real transactions are sent until you explicitly enable live trading AND
# acknowledge the risk flag below.
#
# NEVER commit your real .env. NEVER put your main wallet's key here.
# ============================================================================

# ----------------------------------------------------------------------------
# Trading mode
# ----------------------------------------------------------------------------
# paper = simulated fills against real Jupiter quotes (default, safe)
# live  = real on-chain swaps. Requires LIVE_TRADING_ACKNOWLEDGED=true.
TRADING_MODE=paper

# You must set this to `true` to run in live mode. This is a deliberate
# speed bump: meme coin trading can lose 100% of deployed funds.
LIVE_TRADING_ACKNOWLEDGED=false

# Virtual SOL balance used for paper trading.
PAPER_STARTING_BALANCE_SOL=10

# ----------------------------------------------------------------------------
# Solana RPC
# ----------------------------------------------------------------------------
# Public RPC works for testing, but is heavily rate limited. For anything
# serious use a dedicated provider (Helius, Triton, QuickNode, ...).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# ----------------------------------------------------------------------------
# Wallet (automation / CLI mode only)
# ----------------------------------------------------------------------------
# For the web dashboard you connect Phantom directly in the browser — no key
# is ever needed on the server.
#
# For fully automated (headless) trading you must provide a signer. Use a
# DEDICATED BURNER WALLET funded only with what you can afford to lose.
#
# Option A: path to a JSON keypair file (`solana-keygen new -o burner.json`).
WALLET_KEYPAIR_PATH=
# Option B: base58-encoded secret key (what Phantom exports). Option A is
# preferred; only one of the two should be set.
WALLET_PRIVATE_KEY_BASE58=

# ----------------------------------------------------------------------------
# Jupiter aggregator
# ----------------------------------------------------------------------------
# Free tier: https://lite-api.jup.ag (no key needed, lower rate limits).
# With an API key from https://portal.jup.ag use https://api.jup.ag instead.
JUPITER_API_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Default slippage in basis points (100 = 1%). Meme coins are volatile;
# too low and swaps fail, too high and you get sandwiched.
SLIPPAGE_BPS=100

# Priority fee in lamports, or `auto` to let Jupiter estimate.
PRIORITY_FEE_LAMPORTS=auto

# ----------------------------------------------------------------------------
# Risk management (global caps enforced by the executor, all modes)
# ----------------------------------------------------------------------------
MAX_POSITION_SIZE_SOL=0.1
MAX_OPEN_POSITIONS=5
# The engine halts new buys for the day once realized losses exceed this.
MAX_DAILY_LOSS_SOL=0.5

# Default exit rules applied to new positions (percent).
DEFAULT_TAKE_PROFIT_PCT=50
DEFAULT_STOP_LOSS_PCT=20

# ----------------------------------------------------------------------------
# Token safety filters (checked before every buy)
# ----------------------------------------------------------------------------
SAFETY_MIN_LIQUIDITY_USD=20000
SAFETY_MAX_TOP10_HOLDER_PCT=40
SAFETY_REQUIRE_MINT_AUTHORITY_REVOKED=true
SAFETY_REQUIRE_FREEZE_AUTHORITY_REVOKED=true

# ----------------------------------------------------------------------------
# Engine timing
# ----------------------------------------------------------------------------
PRICE_POLL_INTERVAL_MS=5000
STRATEGY_TICK_INTERVAL_MS=10000

# ----------------------------------------------------------------------------
# Storage & logging
# ----------------------------------------------------------------------------
# SQLite database file (created automatically).
DATABASE_PATH=./data/bot.db
# trace | debug | info | warn | error
LOG_LEVEL=info

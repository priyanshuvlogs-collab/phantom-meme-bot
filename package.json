{
  "name": "phantom-meme-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Solana meme coin trading bot with Phantom wallet support, Jupiter routing, safety filters, and paper trading by default.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @phantom-meme-bot/core db:push",
    "cli": "pnpm --filter @phantom-meme-bot/cli start --",
    "bot": "pnpm --filter @phantom-meme-bot/cli start -- run",
    "web": "pnpm --filter @phantom-meme-bot/web dev",
    "web:build": "pnpm --filter @phantom-meme-bot/web build",
    "web:start": "pnpm --filter @phantom-meme-bot/web start"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
